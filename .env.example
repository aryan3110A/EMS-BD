# ─── Backend (EMS-BD) environment ────────────────────────────────────────────
# Copy to .env for local development. Production values live in deploy/.env on
# the VPS (see deploy/.env.example) and are injected by Docker Compose.
# Never commit real values.

# Any PostgreSQL 16+ database. Local dev example (root docker-compose.yml):
DATABASE_URL="postgresql://ems_user:ems_password@localhost:5432/export_management?schema=public"

# Required in production: random string, at least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=3001
FRONTEND_URL="http://localhost:3000"
# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:3000"

# Production only: set to "true" to expose Swagger docs at /api/docs.
ENABLE_SWAGGER="false"
