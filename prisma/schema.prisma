generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Office {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  city      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  contracts Contract[]
  buyers    Buyer[]

  @@index([isActive])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  officeId     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  office            Office?            @relation(fields: [officeId], references: [id])
  contractsCreated  Contract[]         @relation("ContractCreatedBy")
  salesAttributionsAdded ContractSalesAttribution[] @relation("AttributionAddedBy")
  auditLogs         AuditLog[]
  contractDocuments ContractDocument[]
  contractAuditLogs ContractAuditLog[]
  containerAmendments ContainerCommercialAmendment[]
  containerStatusUpdates ContainerStatusHistory[]
  notifications     Notification[]
  notificationsChanged Notification[] @relation("NotificationChangedBy")
  rawMaterialInwardsCreated RawMaterialInward[] @relation("InwardCreatedBy")
  rawMaterialInwardsUpdated RawMaterialInward[] @relation("InwardUpdatedBy")
  productionRunsCreated ProductionRun[] @relation("ProductionRunCreatedBy")
  productionInputsAdded ProductionInput[] @relation("ProductionInputAddedBy")
  containerAllocations ContainerAllocation[] @relation("AllocationAllocatedBy")
  sampleRecordsUpdated SampleRecord[] @relation("SampleUpdatedBy")
  plantTransfersCreated PlantTransfer[] @relation("TransferCreatedBy")
  plantTransfersReceived PlantTransfer[] @relation("TransferReceivedBy")
  productionAuditLogs ProductionAuditLog[] @relation("ProductionAuditChangedBy")
  inventoryLedgerEntries InventoryLedgerEntry[] @relation("LedgerCreatedBy")

  @@index([officeId])
  @@index([role])
}

model Salesperson {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts     Contract[]
  attributions  ContractSalesAttribution[]

  @@index([isActive])
}

model Country {
  id               String   @id @default(cuid())
  name             String   @unique
  code             String   @unique
  region           String?
  euClassification String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  buyers Buyer[]
  ports  Port[]
}

model Buyer {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  countryId        String
  officeId         String?
  address          String?
  contactPerson    String?
  email            String?
  phone            String?
  euClassification String?
  defaultPortId    String?
  remarks          String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  country     Country    @relation(fields: [countryId], references: [id])
  office      Office?    @relation(fields: [officeId], references: [id])
  defaultPort Port?      @relation(fields: [defaultPortId], references: [id])
  contracts   Contract[]

  @@index([countryId])
  @@index([officeId])
}

model Product {
  id                         String   @id @default(cuid())
  code                       String   @unique
  name                       String
  category                   String?
  defaultSpecification       String?
  standardContainerMt        Float    @default(28)
  defaultUnit                String   @default("MT")
  allowsFullProcess          Boolean  @default(true)
  allowsSortex               Boolean  @default(true)
  samplingNormallyApplicable Boolean  @default(false)
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  variants           ProductVariant[]
  contracts          Contract[]
  contractContainers ContractContainer[]
  containerProducts  ContractContainerProduct[]
  rawMaterialInwards RawMaterialInward[]
  productionRuns     ProductionRun[]
  inventoryBalances  InventoryBalance[]
  ledgerEntries      InventoryLedgerEntry[]
  processedLots      ProcessedOutputLot[]
  sampleRecords      SampleRecord[]
  rejectedLots       SampleRejectedLot[]
  plantTransfers     PlantTransfer[]
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  code           String
  name           String
  processingType String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  contracts Contract[]
  contractContainers ContractContainer[]
  containerProducts  ContractContainerProduct[]

  @@unique([productId, code])
}

model PackagingType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  material    String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sizes              PackagingSize[]
  contracts          Contract[]
  contractContainers ContractContainer[]
  containerProducts  ContractContainerProduct[]
}

model PackagingSize {
  id              String   @id @default(cuid())
  packagingTypeId String
  label           String
  weightKg        Float
  weightUnit      String   @default("KG")
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  packagingType PackagingType @relation(fields: [packagingTypeId], references: [id], onDelete: Cascade)
  contracts     Contract[]
  contractContainers ContractContainer[]
  containerProducts  ContractContainerProduct[]

  @@index([packagingTypeId])
}

model Port {
  id               String   @id @default(cuid())
  name             String
  code             String?
  countryId        String
  portType         String   @default("DESTINATION")
  euClassification String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  country          Country             @relation(fields: [countryId], references: [id])
  buyers           Buyer[]
  contractsLoading Contract[]          @relation("PortOfLoading")
  contractsDest    Contract[]          @relation("DestinationPort")
  lots             ShipmentLot[]
  contractContainers ContractContainer[]

  @@index([countryId])
}

model Contract {
  id                         String    @id @default(cuid())
  officeId                   String
  contractNumber             String    @unique
  receivedDate               DateTime?
  contractDate               DateTime?
  signedContractReceivedDate DateTime?
  contractSentDate           DateTime?
  contractOnBehalfOf         String?
  salespersonId              String?
  buyerId                    String
  productId                  String
  productVariantId           String?
  buyerLotNo                 String?
  invoiceNumber              String?
  invoiceDate                DateTime?
  shippingBillNo             String?
  shippingBillDate           DateTime?
  containerNo                String?

  specification      String?
  qualityRequirement String?
  productRemarks     String?
  buyerRemarks       String?
  processingType     String?
  quantityUnit       String  @default("MT")
  totalMt              Float   @default(0)
  numberOfContainers   Int     @default(1)
  numberOfLots         Int     @default(1)
  standardContainerMt  Float   @default(28)

  incoterm              String  @default("FOB")
  fobPrice              Float?
  fobCurrency           String  @default("USD")
  fobPriceUnit          String  @default("PER_MT")
  freight               Float?
  freightUnit           String?
  insurance             Float?
  cifPrice              Float?
  exchangeRate          Float?
  fobInrPerKg           Float?
  originalContractPrice Float?
  amendmentPrice        Float?
  amendmentCurrency     String?
  amendmentDate         DateTime?
  amendmentReason       String?
  cifManualOverride     Boolean @default(false)

  packagingTypeId    String?
  packagingSizeId    String?
  packingDescription String?
  packingSizeValue   Float?
  packingSizeUnit    String?
  numberOfBags       Int?
  markingRequired    Boolean   @default(false)
  markingDetails     String?
  markingReceivedDate  DateTime?
  markingApprovalDate  DateTime?

  paymentType         String?
  advancePercentage   Float?
  advanceAmount       Float?
  balancePercentage   Float?
  balancePaymentMode  String?
  balancePaymentStage String?
  /// Free-text when payment method is Other
  otherPaymentMethod  String?
  paymentDescription  String?

  portOfLoadingId      String?
  destinationPortId    String?
  destinationCountry   String?
  euClassification     String?
  shipmentPeriodStart  DateTime?
  shipmentPeriodEnd    DateTime?
  expectedShipmentDate DateTime?
  shipmentMonth        String?
  shipmentYear         Int?
  shipmentHalf         String?
  shippingLine         String?
  finalShipmentDate    DateTime?

  orderMt      Float?
  filledMt     Float?
  readyMt      Float?
  dispatchedMt Float?

  status                 String   @default("DRAFT")
  productionInformed     Boolean  @default(false)
  productionInformedDate DateTime?
  remarks                String?
  internalRemarks        String?
  commercialRemarks      String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  office          Office                  @relation(fields: [officeId], references: [id])
  salesperson     Salesperson?            @relation(fields: [salespersonId], references: [id])
  buyer           Buyer                   @relation(fields: [buyerId], references: [id])
  product         Product                 @relation(fields: [productId], references: [id])
  productVariant  ProductVariant?         @relation(fields: [productVariantId], references: [id])
  packagingType   PackagingType?          @relation(fields: [packagingTypeId], references: [id])
  packagingSize   PackagingSize?          @relation(fields: [packagingSizeId], references: [id])
  portOfLoading   Port?                   @relation("PortOfLoading", fields: [portOfLoadingId], references: [id])
  destinationPort Port?                   @relation("DestinationPort", fields: [destinationPortId], references: [id])
  createdBy       User                    @relation("ContractCreatedBy", fields: [createdById], references: [id])
  lots            ShipmentLot[]
  containers      ContractContainer[]
  salesAttributions ContractSalesAttribution[]
  amendments      ContractAmendment[]
  containerAmendments ContainerCommercialAmendment[]
  auditLogs       ContractAuditLog[]
  notifications   Notification[]
  statusHistory   ContractStatusHistory[]
  documents       ContractDocument[]

  @@index([officeId])
  @@index([status])
  @@index([salespersonId])
  @@index([buyerId])
  @@index([contractDate])
  @@index([shipmentMonth, shipmentYear])
  @@index([createdById])
}

model ShipmentLot {
  id                   String    @id @default(cuid())
  contractId           String
  lotNumber            String
  quantityMt           Float
  numberOfContainers   Int       @default(1)
  expectedShipmentDate DateTime?
  shipmentMonth        String?
  shipmentYear         Int?
  shipmentHalf         String?
  destinationPortId    String?
  productionStatus     String    @default("PLANNED")
  dispatchStatus       String    @default("PLANNED")
  remarks              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  destinationPort Port?    @relation(fields: [destinationPortId], references: [id])

  @@unique([contractId, lotNumber])
  @@index([contractId])
}

model ContractContainer {
  id                   String    @id @default(cuid())
  contractId           String
  containerIndex       Int
  /// Legacy primary product (kept for backward compat; prefer `products` relation)
  productId            String
  productVariantId     String?
  processingType       String?
  specification        String?
  productRemarks       String?
  quantityMt           Float?
  containerNo          String?
  factorySealNo        String?
  shippingLineSealNo   String?
  destinationPortId    String?
  expectedShipmentDate DateTime?
  shipmentMonth        String?
  shipmentYear         Int?
  shipmentHalf         String?
  packagingTypeId      String?
  packagingSizeId      String?
  packingDescription   String?
  packingSizeValue     Float?
  packingSizeUnit      String?
  incoterm             String    @default("FOB")
  fobPrice             Float?
  fobCurrency          String?   @default("USD")
  exchangeRate         Float?
  exchangeRateAt       DateTime?
  exchangeRateSource   String?
  exchangeRateManual   Boolean   @default(false)
  fobInrPerKg          Float?
  totalFreight         Float?
  freightPerMt         Float?
  insurance            Float?
  cifPrice             Float?
  cnfPrice             Float?
  originalCifCnfPrice  Float?
  currentCifCnfPrice   Float?
  commercialRemarks    String?
  /// Invoice / payment (container-wise)
  invoiceNumber        String?
  invoiceAmount        Float?
  invoiceDate          DateTime?
  paymentReceived      Boolean   @default(false)
  paymentStatus        String    @default("NOT_RAISED")
  receivedAmount       Float?
  remainingAmount      Float?
  paymentRemarks       String?
  containerStatus      String    @default("DRAFT")
  actualShipmentDate     DateTime?
  dispatchStatus       String    @default("PLANNED")
  /// Future production hooks (not finalized — do not expose in UI yet)
  productionUnitId     String?
  productionRemarks    String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  contract        Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  productVariant  ProductVariant? @relation(fields: [productVariantId], references: [id])
  destinationPort Port?           @relation(fields: [destinationPortId], references: [id])
  packagingType   PackagingType?  @relation(fields: [packagingTypeId], references: [id])
  packagingSize   PackagingSize?  @relation(fields: [packagingSizeId], references: [id])
  products        ContractContainerProduct[]
  amendments      ContainerCommercialAmendment[]
  statusHistory   ContainerStatusHistory[]

  @@unique([contractId, containerIndex])
  @@index([contractId])
  @@index([destinationPortId])
  @@index([expectedShipmentDate])
  @@index([containerStatus])
  @@index([paymentStatus])
}

/// Multiple products inside one container (PDF §5 / §15.4)
model ContractContainerProduct {
  id                 String   @id @default(cuid())
  contractId         String
  containerId        String
  productIndex       Int      @default(1)
  productId          String
  productVariantId   String?
  processingType     String?
  specification      String?
  quantityMt         Float
  packagingTypeId    String?
  packagingSizeId    String?
  packingDescription String?
  packingSizeValue   Float?
  packingSizeUnit    String?
  productRemarks     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  container      ContractContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id])
  productVariant ProductVariant?   @relation(fields: [productVariantId], references: [id])
  packagingType  PackagingType?    @relation(fields: [packagingTypeId], references: [id])
  packagingSize  PackagingSize?    @relation(fields: [packagingSizeId], references: [id])

  @@unique([containerId, productIndex])
  @@index([contractId])
  @@index([containerId])
  @@index([productId])
}

/// Multi-salesperson attribution (PDF §9 / §15.2) — equal credit in Phase 1
model ContractSalesAttribution {
  id               String   @id @default(cuid())
  contractId       String
  salespersonId    String
  contributionPct  Float?
  addedById        String?
  createdAt        DateTime @default(now())

  contract    Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  salesperson Salesperson @relation(fields: [salespersonId], references: [id])
  addedBy     User?       @relation("AttributionAddedBy", fields: [addedById], references: [id])

  @@unique([contractId, salespersonId])
  @@index([contractId])
  @@index([salespersonId])
}

model ContainerStatusHistory {
  id           String   @id @default(cuid())
  containerId  String
  contractId   String
  fromStatus   String?
  toStatus     String
  updatedById  String?
  remarks      String?
  createdAt    DateTime @default(now())

  container ContractContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)
  updatedBy User?             @relation(fields: [updatedById], references: [id])

  @@index([containerId])
  @@index([contractId])
}

model ContractAmendment {
  id              String   @id @default(cuid())
  contractId      String
  amendmentNumber String   @unique
  amendmentDate   DateTime
  amendmentType   String
  originalValue   String?
  amendedValue    String?
  originalPrice   Float?
  amendmentPrice  Float?
  currency        String?
  reason          String
  status          String   @default("DRAFT")
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model ContractStatusHistory {
  id         String   @id @default(cuid())
  contractId String
  fromStatus String?
  toStatus   String
  changedBy  String?
  remarks    String?
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model ContractDocument {
  id           String   @id @default(cuid())
  contractId   String
  name         String
  category     String
  filePath     String
  uploadedById String
  remarks      String?
  createdAt    DateTime @default(now())

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@index([contractId])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  module        String
  action        String
  recordId      String?
  previousValue String?
  newValue      String?
  reason        String?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([module, recordId])
  @@index([createdAt])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ContainerCommercialAmendment {
  id            String   @id @default(cuid())
  contractId    String
  containerId   String
  incoterm      String
  priceType     String   @default("CIF_CNF")
  invoiceNumber String?
  previousValue Float
  amendedValue  Float
  currency      String
  reason        String
  amendedById   String
  amendmentDate DateTime @default(now())
  createdAt     DateTime @default(now())

  contract  Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  container ContractContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)
  amendedBy User              @relation(fields: [amendedById], references: [id])

  @@index([contractId])
  @@index([containerId])
}

model ContractAuditLog {
  id              String   @id @default(cuid())
  contractId      String
  contractNumber  String?
  containerId     String?
  containerIndex  Int?
  fieldName       String
  previousValue   String?
  newValue        String?
  changedById     String
  createdAt       DateTime @default(now())

  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  changedBy User     @relation(fields: [changedById], references: [id])

  @@index([contractId])
  @@index([createdAt])
}

model Notification {
  id           String    @id @default(cuid())
  userId       String?
  targetRole   String?
  contractId   String?
  containerId  String?
  type         String
  message      String
  oldValue     String?
  newValue     String?
  changedById  String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  user      User?     @relation(fields: [userId], references: [id])
  changedBy User?     @relation("NotificationChangedBy", fields: [changedById], references: [id])
  contract  Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([targetRole])
  @@index([contractId])
}

// ─── Production / Inventory / QC ─────────────────────────────────────────────

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inwards          RawMaterialInward[]
  productionInputs ProductionInput[]

  @@index([isActive])
}

model InventoryLocation {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inwards            RawMaterialInward[]
  productionRuns     ProductionRun[]
  balances           InventoryBalance[]
  ledgerAsSource     InventoryLedgerEntry[] @relation("LedgerSourceLocation")
  ledgerAsDest       InventoryLedgerEntry[] @relation("LedgerDestLocation")
  processedLots      ProcessedOutputLot[]
  rejectedLots       SampleRejectedLot[]
  transfersFrom      PlantTransfer[]        @relation("TransferFrom")
  transfersTo        PlantTransfer[]        @relation("TransferTo")

  @@index([isActive])
}

model InwardType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  requiresDesc Boolean @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inwards RawMaterialInward[]
}

model WastageType {
  id          String   @id @default(cuid())
  code        String   @unique
  stage       String
  nameEn      String
  nameLocal   String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cleaningEntries CleaningWastageEntry[]
  hullingEntries  HullingWastageEntry[]

  @@index([stage, isActive])
}

model RawMaterialInward {
  id               String   @id @default(cuid())
  inwardNumber     String   @unique
  supplierId       String
  inwardDate       DateTime
  truckNumber      String
  productId        String
  numberOfBags     Int      @default(0)
  weightKg         Float
  inputUnit        String   @default("MT")
  price            Float?
  inwardTypeId     String
  otherTypeDesc    String?
  locationId       String
  remarks          String?
  status           String   @default("SUBMITTED")
  createdById      String
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplier    Supplier          @relation(fields: [supplierId], references: [id])
  product     Product           @relation(fields: [productId], references: [id])
  inwardType  InwardType        @relation(fields: [inwardTypeId], references: [id])
  location    InventoryLocation @relation(fields: [locationId], references: [id])
  createdBy   User              @relation("InwardCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?             @relation("InwardUpdatedBy", fields: [updatedById], references: [id])
  inputs      ProductionInput[]

  @@index([inwardDate])
  @@index([supplierId])
  @@index([productId])
  @@index([locationId])
  @@index([truckNumber])
}

model InventoryBalance {
  id            String   @id @default(cuid())
  productId     String
  locationId    String
  stockCategory String
  quantityKg    Float    @default(0)
  updatedAt     DateTime @updatedAt

  product  Product           @relation(fields: [productId], references: [id])
  location InventoryLocation @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId, stockCategory])
  @@index([stockCategory])
}

model InventoryLedgerEntry {
  id              String   @id @default(cuid())
  txnNumber       String   @unique
  txnType         String
  productId       String
  stockCategory   String
  sourceLocationId String?
  destLocationId  String?
  quantityInKg    Float    @default(0)
  quantityOutKg   Float    @default(0)
  balanceKg       Float?
  referenceType   String?
  referenceId     String?
  remarks         String?
  createdById     String?
  createdAt       DateTime @default(now())

  product        Product            @relation(fields: [productId], references: [id])
  sourceLocation InventoryLocation? @relation("LedgerSourceLocation", fields: [sourceLocationId], references: [id])
  destLocation   InventoryLocation? @relation("LedgerDestLocation", fields: [destLocationId], references: [id])
  createdBy      User?              @relation("LedgerCreatedBy", fields: [createdById], references: [id])

  @@index([productId, stockCategory])
  @@index([txnType])
  @@index([createdAt])
  @@index([referenceId])
}

model ProductionRun {
  id                   String    @id @default(cuid())
  productionNumber     String    @unique
  plantId              String
  processType          String
  productId            String
  status               String    @default("DRAFT")
  startDate            DateTime
  completionDate       DateTime?
  daysSpanned          Int?
  totalInputKg         Float     @default(0)
  cleaningWastageKg    Float     @default(0)
  hullingInputKg       Float     @default(0)
  hullingWastageKg     Float     @default(0)
  hullingWastagePct    Float?
  netOutputKg          Float     @default(0)
  allocatedKg          Float     @default(0)
  storedProcessedKg    Float     @default(0)
  wastageAlert         Boolean   @default(false)
  cleaningFinalizedAt  DateTime?
  hullingFinalizedAt   DateTime?
  remarks              String?
  createdById          String
  cancelledAt          DateTime?
  cancelReason         String?
  cancelledById        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  plant      InventoryLocation   @relation(fields: [plantId], references: [id])
  product    Product             @relation(fields: [productId], references: [id])
  createdBy  User                @relation("ProductionRunCreatedBy", fields: [createdById], references: [id])
  inputs     ProductionInput[]
  cleaning   CleaningWastageEntry[]
  hulling    HullingWastageEntry[]
  outputLots ProcessedOutputLot[]
  allocations ContainerAllocation[]
  sampleRecords SampleRecord[]
  rejectedLots SampleRejectedLot[]
  transfers  PlantTransfer[]

  @@index([status])
  @@index([plantId])
  @@index([productId])
  @@index([startDate])
  @@index([wastageAlert])
}

model ProductionInput {
  id              String   @id @default(cuid())
  productionRunId String
  inputDate       DateTime
  productId       String
  supplierId      String?
  inwardId        String?
  stockCategory   String   @default("NORMAL_RAW_MATERIAL")
  rejectedLotId   String?
  processedLotId  String?
  quantityKg      Float
  inputUnit       String   @default("MT")
  isAdditional    Boolean  @default(false)
  remarks         String?
  addedById       String
  createdAt       DateTime @default(now())

  productionRun ProductionRun      @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  supplier      Supplier?          @relation(fields: [supplierId], references: [id])
  inward        RawMaterialInward? @relation(fields: [inwardId], references: [id])
  rejectedLot   SampleRejectedLot? @relation(fields: [rejectedLotId], references: [id])
  processedLot  ProcessedOutputLot? @relation(fields: [processedLotId], references: [id])
  addedBy       User               @relation("ProductionInputAddedBy", fields: [addedById], references: [id])

  @@index([productionRunId])
}

model CleaningWastageEntry {
  id              String   @id @default(cuid())
  productionRunId String
  wastageTypeId   String
  quantityKg      Float
  inputUnit       String   @default("KG")
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productionRun ProductionRun @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  wastageType   WastageType   @relation(fields: [wastageTypeId], references: [id])

  @@unique([productionRunId, wastageTypeId])
}

model HullingWastageEntry {
  id              String   @id @default(cuid())
  productionRunId String
  wastageTypeId   String
  numberOfBags    Float?
  weightPerBagKg Float?
  directQtyKg     Float?
  quantityKg      Float
  inputUnit       String   @default("KG")
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productionRun ProductionRun @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  wastageType   WastageType   @relation(fields: [wastageTypeId], references: [id])

  @@unique([productionRunId, wastageTypeId])
}

model ProcessedOutputLot {
  id                String   @id @default(cuid())
  lotNumber         String   @unique
  productionRunId   String
  productId         String
  plantId           String
  processType       String
  quantityKg        Float
  availableKg       Float
  reservedKg        Float    @default(0)
  status            String   @default("AVAILABLE")
  completionDate    DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productionRun ProductionRun        @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  product       Product              @relation(fields: [productId], references: [id])
  plant         InventoryLocation    @relation(fields: [plantId], references: [id])
  allocations   ContainerAllocation[]
  sampleRecords SampleRecord[]
  inputsReuse   ProductionInput[]
  transfers     PlantTransfer[]

  @@index([productId, plantId, status])
  @@index([productionRunId])
}

model ContainerAllocation {
  id                   String   @id @default(cuid())
  productionRunId      String?
  processedLotId       String?
  contractId           String
  containerId          String
  containerProductId   String?
  productId            String
  quantityKg           Float
  allocationDate       DateTime @default(now())
  allocatedById        String
  status               String   @default("ACTIVE")
  remarks              String?
  createdAt            DateTime @default(now())

  productionRun    ProductionRun?      @relation(fields: [productionRunId], references: [id])
  processedLot     ProcessedOutputLot? @relation(fields: [processedLotId], references: [id])
  allocatedBy      User                @relation("AllocationAllocatedBy", fields: [allocatedById], references: [id])
  sampleRecords    SampleRecord[]

  @@index([contractId, containerId])
  @@index([productionRunId])
  @@index([productId])
}

model SampleRecord {
  id              String    @id @default(cuid())
  contractId      String
  containerId     String
  productId       String
  allocationId    String?
  productionRunId String?
  processedLotId  String?
  status          String    @default("READY_FOR_SAMPLING")
  collectionDate  DateTime?
  testingAgency   String?
  resultDate      DateTime?
  result          String?
  reportReference String?
  reportPath      String?
  remarks         String?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product       Product             @relation(fields: [productId], references: [id])
  allocation    ContainerAllocation? @relation(fields: [allocationId], references: [id])
  productionRun ProductionRun?      @relation(fields: [productionRunId], references: [id])
  processedLot  ProcessedOutputLot? @relation(fields: [processedLotId], references: [id])
  updatedBy     User?               @relation("SampleUpdatedBy", fields: [updatedById], references: [id])
  rejectedLots  SampleRejectedLot[]

  @@index([containerId])
  @@index([status])
  @@index([contractId])
}

model SampleRejectedLot {
  id                String   @id @default(cuid())
  lotNumber         String   @unique
  productId         String
  quantityKg        Float
  availableKg       Float
  reprocessedKg     Float    @default(0)
  transferredKg     Float    @default(0)
  plantId           String
  productionRunId   String?
  contractId        String?
  containerId       String?
  sampleRecordId    String?
  failureDate       DateTime
  failureRemarks    String?
  status            String   @default("AVAILABLE_FOR_SORTEX")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product       Product            @relation(fields: [productId], references: [id])
  plant         InventoryLocation  @relation(fields: [plantId], references: [id])
  productionRun ProductionRun?     @relation(fields: [productionRunId], references: [id])
  sampleRecord  SampleRecord?      @relation(fields: [sampleRecordId], references: [id])
  inputsReuse   ProductionInput[]
  transfers     PlantTransfer[]

  @@index([status])
  @@index([productId, plantId])
}

model PlantTransfer {
  id                String    @id @default(cuid())
  transferNumber    String    @unique
  transferDate      DateTime
  sourceLocationId  String
  destLocationId    String
  stockCategory     String
  productId         String
  processedLotId    String?
  rejectedLotId     String?
  productionRunId   String?
  quantityKg        Float
  inputUnit         String    @default("MT")
  remarks           String?
  status            String    @default("DRAFT")
  createdById       String
  dispatchDate      DateTime?
  receivedDate      DateTime?
  receivedById      String?
  linkedInwardId    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sourceLocation InventoryLocation  @relation("TransferFrom", fields: [sourceLocationId], references: [id])
  destLocation   InventoryLocation  @relation("TransferTo", fields: [destLocationId], references: [id])
  product        Product            @relation(fields: [productId], references: [id])
  processedLot   ProcessedOutputLot? @relation(fields: [processedLotId], references: [id])
  rejectedLot    SampleRejectedLot? @relation(fields: [rejectedLotId], references: [id])
  productionRun  ProductionRun?     @relation(fields: [productionRunId], references: [id])
  createdBy      User               @relation("TransferCreatedBy", fields: [createdById], references: [id])
  receivedBy     User?              @relation("TransferReceivedBy", fields: [receivedById], references: [id])

  @@index([status])
  @@index([sourceLocationId])
  @@index([destLocationId])
}

model ProductionAuditLog {
  id           String   @id @default(cuid())
  module       String
  recordType   String
  recordNumber String?
  action       String
  fieldName    String?
  oldValue     String?
  newValue     String?
  changedById  String?
  reason       String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  changedBy User? @relation("ProductionAuditChangedBy", fields: [changedById], references: [id])

  @@index([module])
  @@index([recordNumber])
  @@index([createdAt])
}

